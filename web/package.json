{
  "name": "custos-cozinha",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "dev:emulador": "vite --mode emulador",
    "emuladores": "firebase emulators:start --project demo-custos-cozinha",
    "deploy": "npm test && vite build && firebase deploy --only hosting,firestore",
    "test:emulador": "firebase emulators:exec --only auth,firestore --project demo-custos-cozinha \"vitest run --config vitest.emulador.config.js\""
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/dm-serif-display": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "decimal.js": "^10.6.0",
    "firebase": "^13.1.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "firebase-tools": "^15.34.0",
    "linkedom": "^0.18.14",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
